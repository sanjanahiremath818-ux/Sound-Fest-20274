# ===========================================
# REQUIRED - Database (Neon PostgreSQL)
# ===========================================
# Get this from https://console.neon.tech → your project → Connection Details
DATABASE_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ===========================================
# REQUIRED - Authentication
# ===========================================
# Generate a long random string (at least 32 characters)
# You can use: https://generate-secret.vercel.app/32
AUTH_SECRET="change-this-to-a-long-random-secret-string-at-least-32-chars"

# ===========================================
# REQUIRED - App URL (after deployment)
# ===========================================
# Example: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# OPTIONAL - Email (Resend)
# ===========================================
# Get from https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="Event Team"

# ===========================================
# OPTIONAL - Admin credentials (for first login)
# ===========================================
# These are only used by the seed script
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@12345"
